{
  "name": "landfall",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "data:import": "tsx scripts/import/cli.ts",
    "data:generate": "tsx scripts/import/cli.ts --generate-only",
    "updates:generate": "tsx scripts/updates/generate.ts",
    "sample:freeze": "tsx scripts/sample/freeze.ts",
    "og:image": "tsx scripts/og-image/render.ts",
    "updates:summary": "tsx scripts/updates/summary.ts",
    "updates:retention": "tsx scripts/updates/retention.ts",
    "updates:frozen-check": "tsx scripts/automation/frozen-check.ts",
    "social:render": "tsx scripts/social/render.ts",
    "data:state-lists": "tsx scripts/state-lists/cli.ts",
    "page-watch": "tsx scripts/page-watch/cli.ts",
    "predev": "tsx scripts/copy-public-data.ts",
    "prebuild": "tsx scripts/copy-public-data.ts && tsx scripts/check-rule-staleness.ts",
    "backend:check": "deno task --config supabase/functions/deno.json check",
    "backend:test": "deno task --config supabase/functions/deno.json test",
    "backend:test:sql": "python3 supabase/tests/postgres_test.py",
    "lighthouse": "tsx scripts/lighthouse/cli.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/big-shoulders-stencil-display": "5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@mantine/core": "9.8.1",
    "@mantine/dates": "9.8.1",
    "@mantine/hooks": "9.8.1",
    "dayjs": "1.11.23",
    "lucide-react": "^0.577.0",
    "motion": "14.14.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "chrome-launcher": "1.2.1",
    "deno": "2.9.6",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "lighthouse": "13.6.0",
    "prettier": "3.10.1",
    "puppeteer-core": "25.18.1",
    "sharp": "0.35.5",
    "supabase": "3.2.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.0",
    "vitest": "4.1.12"
  },
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 111",
    "safari 16.4"
  ]
}
